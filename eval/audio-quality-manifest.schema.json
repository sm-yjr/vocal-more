{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocal-more.local/schemas/audio-quality-manifest-v1.json",
  "title": "Vocal More physical microphone gain-control A/B manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "provenance", "environment", "recordings"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "environment": {
      "type": "object",
      "required": ["hardware_model", "microphone", "macos_version", "app_version"],
      "properties": {
        "hardware_model": {"type": "string", "minLength": 1},
        "microphone": {"type": "string", "minLength": 1},
        "macos_version": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1},
        "room": {"type": "string"},
        "microphone_distance_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speaker_position": {"type": "string"},
        "ambient_condition": {"type": "string"},
        "capture_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "pair_count",
            "duration_seconds",
            "manual_gain_db",
            "highpass_enabled",
            "highpass_hz",
            "soft_limiter_enabled",
            "capture_host",
            "stimulus_count",
            "stimulus_set_sha256",
            "stimulus_text_persisted"
          ],
          "properties": {
            "order": {"const": "ABBA"},
            "pair_count": {"type": "integer", "minimum": 2, "multipleOf": 2},
            "duration_seconds": {"type": "number", "minimum": 2},
            "manual_gain_db": {"type": "number", "minimum": -6, "maximum": 34},
            "highpass_enabled": {"type": "boolean"},
            "highpass_hz": {"type": "number", "exclusiveMinimum": 0},
            "soft_limiter_enabled": {"type": "boolean"},
            "capture_host": {"enum": ["terminal_process", "vocal_more_app"]},
            "stimulus_count": {"type": "integer", "minimum": 2},
            "stimulus_set_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "stimulus_text_persisted": {"const": false}
          }
        }
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_ms": {
          "type": "number",
          "minimum": 5,
          "maximum": 100,
          "default": 20
        },
        "silence_threshold_dbfs": {
          "type": "number",
          "minimum": -120,
          "exclusiveMaximum": 0,
          "default": -50
        },
        "clipping_threshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1,
          "default": 0.999
        }
      }
    },
    "recordings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/recording"
      }
    }
  },
  "$defs": {
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "caller_attestation"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "capture_tool",
            "capture_schema_version",
            "runtime_sidecar",
            "runtime_records_sha256"
          ],
          "properties": {
            "kind": {"const": "vocal_more_runtime_capture"},
            "capture_tool": {"const": "scripts/capture_audio_quality_ab.py"},
            "capture_schema_version": {"const": 2},
            "runtime_sidecar": {"const": "capture-runtime-status.json"},
            "runtime_records_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pair_id",
        "audio",
        "capture_sequence",
        "requested_gain_mode",
        "actual_gain_control",
        "preferred_microphone_mode",
        "active_microphone_mode",
        "phase",
        "processing_active",
        "device_name",
        "system_default",
        "native_backend",
        "processing_mode",
        "converter_name",
        "source_sample_rate_hz",
        "source_channels",
        "output_sample_rate_hz",
        "output_channels",
        "output_sample_width_bytes",
        "output_encoding",
        "highpass_effective",
        "voice_processing_enabled_observed",
        "agc_enabled_observed",
        "gain_control_verified",
        "fallback_code",
        "fallback_stage",
        "queue_dropped_blocks",
        "runtime_fault_count",
        "runtime_fault_code"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pair_id": {"type": "string", "minLength": 1},
        "audio": {
          "type": "string",
          "pattern": "\\.(wav|pcm|raw)$"
        },
        "capture_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "requested_gain_mode": {
          "enum": ["automatic", "manual"]
        },
        "actual_gain_control": {
          "enum": ["apple_agc", "software", "software_fallback"]
        },
        "preferred_microphone_mode": {
          "type": "string",
          "minLength": 1
        },
        "active_microphone_mode": {
          "type": "string",
          "minLength": 1
        },
        "phase": {"type": "string", "minLength": 1},
        "processing_active": {"type": "boolean"},
        "device_name": {"type": "string", "minLength": 1},
        "system_default": {"type": "boolean"},
        "native_backend": {"type": "string", "minLength": 1},
        "processing_mode": {"type": "string", "minLength": 1},
        "converter_name": {"type": "string", "minLength": 1},
        "source_sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "source_channels": {"type": "integer", "minimum": 1},
        "output_sample_rate_hz": {"type": "integer", "minimum": 1},
        "output_channels": {"type": "integer", "minimum": 1},
        "output_sample_width_bytes": {"const": 2},
        "output_encoding": {"const": "pcm_s16le"},
        "highpass_effective": {"type": "boolean"},
        "voice_processing_enabled_observed": {
          "type": ["boolean", "null"]
        },
        "agc_enabled_observed": {
          "type": ["boolean", "null"]
        },
        "gain_control_verified": {"type": "boolean"},
        "fallback_code": {"type": ["string", "null"]},
        "fallback_stage": {"type": ["string", "null"]},
        "queue_dropped_blocks": {"type": "integer", "minimum": 0},
        "runtime_fault_count": {"type": "integer", "minimum": 0},
        "runtime_fault_code": {"type": ["string", "null"]},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "sample_width_bytes": {
          "const": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requested_gain_mode": {"const": "manual"}
            },
            "required": ["requested_gain_mode"]
          },
          "then": {
            "properties": {
              "actual_gain_control": {"const": "software"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "requested_gain_mode": {"const": "automatic"}
            },
            "required": ["requested_gain_mode"]
          },
          "then": {
            "properties": {
              "actual_gain_control": {
                "enum": ["apple_agc", "software_fallback"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audio": {"pattern": "\\.(pcm|raw)$"}
            },
            "required": ["audio"]
          },
          "then": {
            "required": ["sample_rate_hz", "sample_width_bytes"]
          }
        }
      ]
    }
  }
}
